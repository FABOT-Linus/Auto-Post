# ============================================
# Daily Financial News Poster — Environment
# ============================================
# Copy this file to .env and fill in your credentials.
# For GitHub Actions, add each as a repository secret.

# --- News API ---
NEWS_API_KEY=your_newsapi_key_here

# --- X.com (Twitter) ---
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret

# --- Facebook ---
FB_APP_ID=your_fb_app_id
FB_APP_SECRET=your_fb_app_secret
FB_PAGE_ACCESS_TOKEN=your_long_lived_page_token
FB_PAGE_ID=your_fb_page_id

# --- Instagram ---
IG_ACCESS_TOKEN=your_ig_access_token
IG_BUSINESS_ACCOUNT_ID=your_ig_business_account_id

# --- LinkedIn ---
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_REFRESH_TOKEN=your_linkedin_refresh_token
LINKEDIN_MEMBER_URN=urn:li:person:your_person_id

# --- News Settings (optional) ---
NEWS_KEYWORDS=stock market,economy,investing
NEWS_CATEGORIES=business
MAX_HEADLINES=3

# --- Platform Toggles ---
ENABLE_X=true
ENABLE_FACEBOOK=true
ENABLE_INSTAGRAM=true
ENABLE_LINKEDIN=true

# --- X.com Image Post Mode (optional) ---
# When true, generates a financial news image card and posts it with the tweet
ENABLE_X_IMAGE=true
