# ----- EMAIL (IMAP) -----
# For Gmail: use an "App Password", not your normal password.
# Create one at https://myaccount.google.com/apppasswords
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_ADDRESS=youraddress@gmail.com
EMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Only process emails from this sender / with this subject keyword (leave blank to match any)
EMAIL_SENDER_FILTER=newsletter@example.com
EMAIL_SUBJECT_FILTER=Daily News

# ----- GROQ (content generation - free tier, no cost) -----
# Create a free account and API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx

# ----- LINKEDIN -----
# Create an app at https://www.linkedin.com/developers/apps
# You need the "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect" products approved,
# then run the OAuth flow once to get a long-lived access token.
LINKEDIN_ACCESS_TOKEN=xxxxxxxxxxxxxxxx
LINKEDIN_PERSON_URN=urn:li:person:xxxxxxxx

# ----- REDDIT -----
# Create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=xxxxxxxxxxxxxxxx
REDDIT_CLIENT_SECRET=xxxxxxxxxxxxxxxx
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password
REDDIT_USER_AGENT=social-automation-bot/1.0 by u/your_reddit_username
REDDIT_SUBREDDIT=YourSubredditName

# ----- INSTAGRAM (via Facebook Graph API / Instagram Business account) -----
# Requires: Instagram Business/Creator account linked to a Facebook Page,
# a Facebook App, and a long-lived Page Access Token.
# See: https://developers.facebook.com/docs/instagram-api/guides/content-publishing
IG_ACCESS_TOKEN=xxxxxxxxxxxxxxxx
IG_BUSINESS_ACCOUNT_ID=xxxxxxxxxxxxxxxx

# ----- IMAGE GENERATION (for the Instagram image) -----
# Uses Pollinations.ai (https://pollinations.ai) - completely free, no API
# key or account needed. Nothing to configure here.
